<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Invoice</label>
    <pluralLabel>Invoices</pluralLabel>
    <nameField>
        <label>Invoice Number</label>
        <type>AutoNumber</type>
        <displayFormat>INV-{YYYY}-{00000}</displayFormat>
        <startingNumber>1</startingNumber>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <description>Customer invoices with payment tracking, aging analysis, and automated email delivery.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>

    <fields>
        <fullName>Account__c</fullName>
        <label>Account</label>
        <type>Lookup</type>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Invoices</relationshipLabel>
        <relationshipName>Invoices</relationshipName>
        <deleteConstraint>SetNull</deleteConstraint>
        <required>true</required>
    </fields>
    <fields>
        <fullName>Opportunity__c</fullName>
        <label>Opportunity</label>
        <type>Lookup</type>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>Invoices</relationshipLabel>
        <relationshipName>Invoices</relationshipName>
        <deleteConstraint>SetNull</deleteConstraint>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <label>Status</label>
        <type>Picklist</type>
        <required>true</required>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Draft</fullName><default>true</default><label>Draft</label></value>
                <value><fullName>Sent</fullName><default>false</default><label>Sent</label></value>
                <value><fullName>Partially Paid</fullName><default>false</default><label>Partially Paid</label></value>
                <value><fullName>Paid</fullName><default>false</default><label>Paid</label></value>
                <value><fullName>Overdue</fullName><default>false</default><label>Overdue</label></value>
                <value><fullName>Cancelled</fullName><default>false</default><label>Cancelled</label></value>
                <value><fullName>Write Off</fullName><default>false</default><label>Write Off</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Invoice_Date__c</fullName>
        <label>Invoice Date</label>
        <type>Date</type>
        <required>true</required>
        <defaultValue>TODAY()</defaultValue>
    </fields>
    <fields>
        <fullName>Due_Date__c</fullName>
        <label>Due Date</label>
        <type>Date</type>
        <required>true</required>
    </fields>
    <fields>
        <fullName>Subtotal__c</fullName>
        <label>Subtotal</label>
        <type>Currency</type>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Discount_Amount__c</fullName>
        <label>Discount Amount</label>
        <type>Currency</type>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <defaultValue>0</defaultValue>
    </fields>
    <fields>
        <fullName>Tax_Amount__c</fullName>
        <label>Tax Amount</label>
        <type>Currency</type>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <defaultValue>0</defaultValue>
    </fields>
    <fields>
        <fullName>Total_Amount__c</fullName>
        <label>Total Amount</label>
        <type>Formula</type>
        <formula>(Subtotal__c - Discount_Amount__c) + Tax_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <returnType>Currency</returnType>
        <precision>16</precision>
        <scale>2</scale>
    </fields>
    <fields>
        <fullName>Amount_Paid__c</fullName>
        <label>Amount Paid</label>
        <type>Currency</type>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <defaultValue>0</defaultValue>
        <description>Sum of all linked Payment records.</description>
    </fields>
    <fields>
        <fullName>Balance_Due__c</fullName>
        <label>Balance Due</label>
        <type>Formula</type>
        <formula>Total_Amount__c - Amount_Paid__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <returnType>Currency</returnType>
        <precision>16</precision>
        <scale>2</scale>
    </fields>
    <fields>
        <fullName>Days_Overdue__c</fullName>
        <label>Days Overdue</label>
        <type>Formula</type>
        <formula>IF(AND(Status__c = 'Overdue', Due_Date__c &lt; TODAY()), TODAY() - Due_Date__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <returnType>Number</returnType>
        <precision>5</precision>
        <scale>0</scale>
    </fields>
    <fields>
        <fullName>Currency_Code__c</fullName>
        <label>Currency Code</label>
        <type>Text</type>
        <length>3</length>
        <required>false</required>
        <defaultValue>&apos;USD&apos;</defaultValue>
    </fields>
    <fields>
        <fullName>Notes__c</fullName>
        <label>Notes</label>
        <type>LongTextArea</type>
        <length>32768</length>
        <visibleLines>3</visibleLines>
        <required>false</required>
    </fields>
</CustomObject>
