<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Inventory Item</label>
    <pluralLabel>Inventory Items</pluralLabel>
    <nameField>
        <label>Item Name</label>
        <type>Text</type>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <description>Inventory catalog items with real-time stock levels, warehouse assignments, and AI reorder intelligence.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableChangeDataCapture>true</enableChangeDataCapture>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>

    <fields>
        <fullName>SKU__c</fullName>
        <label>SKU</label>
        <type>Text</type>
        <length>50</length>
        <unique>true</unique>
        <externalId>true</externalId>
        <required>true</required>
        <description>Stock Keeping Unit — unique product identifier</description>
    </fields>
    <fields>
        <fullName>Barcode__c</fullName>
        <label>Barcode</label>
        <type>Text</type>
        <length>50</length>
        <unique>false</unique>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Category__c</fullName>
        <label>Category</label>
        <type>Picklist</type>
        <required>false</required>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Raw Material</fullName><default>false</default><label>Raw Material</label></value>
                <value><fullName>Finished Good</fullName><default>false</default><label>Finished Good</label></value>
                <value><fullName>Work in Progress</fullName><default>false</default><label>Work in Progress</label></value>
                <value><fullName>Consumable</fullName><default>false</default><label>Consumable</label></value>
                <value><fullName>Equipment</fullName><default>false</default><label>Equipment</label></value>
                <value><fullName>Spare Part</fullName><default>false</default><label>Spare Part</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Warehouse__c</fullName>
        <label>Primary Warehouse</label>
        <type>Lookup</type>
        <referenceTo>Warehouse__c</referenceTo>
        <relationshipLabel>Inventory Items</relationshipLabel>
        <relationshipName>Inventory_Items</relationshipName>
        <deleteConstraint>SetNull</deleteConstraint>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Primary_Vendor__c</fullName>
        <label>Primary Vendor</label>
        <type>Lookup</type>
        <referenceTo>Vendor__c</referenceTo>
        <relationshipLabel>Primary Products</relationshipLabel>
        <relationshipName>Primary_Products</relationshipName>
        <deleteConstraint>SetNull</deleteConstraint>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Current_Stock__c</fullName>
        <label>Current Stock</label>
        <type>Number</type>
        <precision>12</precision>
        <scale>2</scale>
        <required>true</required>
        <defaultValue>0</defaultValue>
    </fields>
    <fields>
        <fullName>Reserved_Stock__c</fullName>
        <label>Reserved Stock</label>
        <type>Number</type>
        <precision>12</precision>
        <scale>2</scale>
        <required>false</required>
        <defaultValue>0</defaultValue>
        <description>Stock committed to open orders but not yet shipped.</description>
    </fields>
    <fields>
        <fullName>Available_Stock__c</fullName>
        <label>Available Stock</label>
        <type>Formula</type>
        <formula>Current_Stock__c - Reserved_Stock__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <returnType>Number</returnType>
        <precision>12</precision>
        <scale>2</scale>
    </fields>
    <fields>
        <fullName>Reorder_Point__c</fullName>
        <label>Reorder Point</label>
        <type>Number</type>
        <precision>12</precision>
        <scale>2</scale>
        <required>false</required>
        <defaultValue>10</defaultValue>
        <description>AI-optimized reorder threshold. Triggers procurement workflow when Available_Stock falls below this.</description>
    </fields>
    <fields>
        <fullName>Reorder_Quantity__c</fullName>
        <label>Reorder Quantity</label>
        <type>Number</type>
        <precision>12</precision>
        <scale>2</scale>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Unit_Cost__c</fullName>
        <label>Unit Cost</label>
        <type>Currency</type>
        <precision>16</precision>
        <scale>4</scale>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Selling_Price__c</fullName>
        <label>Selling Price</label>
        <type>Currency</type>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Unit_of_Measure__c</fullName>
        <label>Unit of Measure</label>
        <type>Picklist</type>
        <required>false</required>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Each</fullName><default>true</default><label>Each</label></value>
                <value><fullName>Kg</fullName><default>false</default><label>Kg</label></value>
                <value><fullName>Litre</fullName><default>false</default><label>Litre</label></value>
                <value><fullName>Box</fullName><default>false</default><label>Box</label></value>
                <value><fullName>Pallet</fullName><default>false</default><label>Pallet</label></value>
                <value><fullName>Meter</fullName><default>false</default><label>Meter</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Is_Low_Stock__c</fullName>
        <label>Is Low Stock</label>
        <type>Formula</type>
        <formula>Available_Stock__c &lt; Reorder_Point__c</formula>
        <returnType>Checkbox</returnType>
        <description>True when available stock falls below reorder point. Drives alert workflows.</description>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <label>Status</label>
        <type>Picklist</type>
        <required>true</required>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Active</fullName><default>true</default><label>Active</label></value>
                <value><fullName>Discontinued</fullName><default>false</default><label>Discontinued</label></value>
                <value><fullName>Out of Stock</fullName><default>false</default><label>Out of Stock</label></value>
                <value><fullName>On Order</fullName><default>false</default><label>On Order</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <label>Description</label>
        <type>LongTextArea</type>
        <length>32768</length>
        <visibleLines>3</visibleLines>
        <required>false</required>
    </fields>
</CustomObject>
