<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Payment</label>
    <pluralLabel>Payments</pluralLabel>
    <nameField>
        <label>Payment Number</label>
        <type>AutoNumber</type>
        <displayFormat>PAY-{YYYY}-{00000}</displayFormat>
        <startingNumber>1</startingNumber>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>

    <fields>
        <fullName>Invoice__c</fullName>
        <label>Invoice</label>
        <type>MasterDetail</type>
        <referenceTo>Invoice__c</referenceTo>
        <relationshipLabel>Payments</relationshipLabel>
        <relationshipName>Payments</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
    </fields>
    <fields>
        <fullName>Amount__c</fullName>
        <label>Amount</label>
        <type>Currency</type>
        <precision>16</precision>
        <scale>2</scale>
        <required>true</required>
    </fields>
    <fields>
        <fullName>Payment_Date__c</fullName>
        <label>Payment Date</label>
        <type>Date</type>
        <required>true</required>
    </fields>
    <fields>
        <fullName>Payment_Method__c</fullName>
        <label>Payment Method</label>
        <type>Picklist</type>
        <required>true</required>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Bank Transfer</fullName><default>true</default><label>Bank Transfer</label></value>
                <value><fullName>Credit Card</fullName><default>false</default><label>Credit Card</label></value>
                <value><fullName>Cheque</fullName><default>false</default><label>Cheque</label></value>
                <value><fullName>Cash</fullName><default>false</default><label>Cash</label></value>
                <value><fullName>PayPal</fullName><default>false</default><label>PayPal</label></value>
                <value><fullName>Stripe</fullName><default>false</default><label>Stripe</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Reference_Number__c</fullName>
        <label>Reference Number</label>
        <type>Text</type>
        <length>100</length>
        <required>false</required>
        <description>Bank transaction reference or payment gateway transaction ID.</description>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <label>Status</label>
        <type>Picklist</type>
        <required>true</required>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Pending</fullName><default>true</default><label>Pending</label></value>
                <value><fullName>Confirmed</fullName><default>false</default><label>Confirmed</label></value>
                <value><fullName>Failed</fullName><default>false</default><label>Failed</label></value>
                <value><fullName>Refunded</fullName><default>false</default><label>Refunded</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Notes__c</fullName>
        <label>Notes</label>
        <type>TextArea</type>
        <required>false</required>
    </fields>
</CustomObject>
