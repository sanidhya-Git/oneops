<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_Score_Range</fullName>
    <active>true</active>
    <description>Lead AI Score must be between 0 and 100.</description>
    <errorConditionFormula>NOT(ISBLANK(Lead_Score__c)) &amp;&amp; (Lead_Score__c &lt; 0 || Lead_Score__c &gt; 100)</errorConditionFormula>
    <errorDisplayField>Lead_Score__c</errorDisplayField>
    <errorMessage>Lead Score must be between 0 and 100.</errorMessage>
</ValidationRule>
