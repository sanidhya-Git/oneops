<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Department</label>
    <pluralLabel>Departments</pluralLabel>
    <nameField>
        <label>Department Name</label>
        <type>Text</type>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <description>Organizational departments used for employee hierarchy, budgets, and reporting.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>

    <fields>
        <fullName>Department_Code__c</fullName>
        <label>Department Code</label>
        <type>Text</type>
        <length>10</length>
        <unique>true</unique>
        <externalId>true</externalId>
        <required>true</required>
        <description>Short unique code, e.g. ENG, HR, FIN, OPS</description>
    </fields>
    <fields>
        <fullName>Head_of_Department__c</fullName>
        <label>Head of Department</label>
        <type>Lookup</type>
        <referenceTo>Employee__c</referenceTo>
        <relationshipLabel>Department Led</relationshipLabel>
        <relationshipName>Department_Led</relationshipName>
        <deleteConstraint>SetNull</deleteConstraint>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Parent_Department__c</fullName>
        <label>Parent Department</label>
        <type>Lookup</type>
        <referenceTo>Department__c</referenceTo>
        <relationshipLabel>Sub-Departments</relationshipLabel>
        <relationshipName>Sub_Departments</relationshipName>
        <deleteConstraint>SetNull</deleteConstraint>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Budget__c</fullName>
        <label>Annual Budget</label>
        <type>Currency</type>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Headcount__c</fullName>
        <label>Headcount</label>
        <type>Number</type>
        <precision>5</precision>
        <scale>0</scale>
        <required>false</required>
        <description>Current employee count. Updated by trigger on Employee changes.</description>
    </fields>
    <fields>
        <fullName>Cost_Center__c</fullName>
        <label>Cost Center</label>
        <type>Text</type>
        <length>20</length>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Is_Active__c</fullName>
        <label>Is Active</label>
        <type>Checkbox</type>
        <defaultValue>true</defaultValue>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <label>Description</label>
        <type>LongTextArea</type>
        <length>32768</length>
        <visibleLines>3</visibleLines>
        <required>false</required>
    </fields>
</CustomObject>
