{
    "name":              "production",
    "salesforce": {
        "loginUrl":      "https://login.salesforce.com",
        "apiVersion":    "59.0",
        "orgAlias":      "oneops-prod"
    },
    "aiEngine": {
        "url":           "https://ai.internal:3001",
        "provider":      "openai",
        "model":         "gpt-4o",
        "fallbackOrder": ["openai", "claude", "gemini"],
        "timeout":       30000
    },
    "redis": {
        "url":           "redis://redis:6379",
        "ttl":           900
    },
    "logging": {
        "level":         "warn",
        "format":        "json"
    },
    "rateLimit": {
        "windowMs":      900000,
        "max":           100
    },
    "features": {
        "aiScoring":     true,
        "aiChat":        true,
        "notifications": true,
        "workflows":     true,
        "batchScoring":  true
    }
}
