# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_VERSION=v1

# ── Security ──────────────────────────────────────────────────
# Shared secret that Salesforce Named Credential sends in Authorization header
ONEOPS_API_SECRET=change-me-in-production-use-256bit-random

# ── Primary AI Provider: OpenAI ───────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ── Secondary AI Provider: Anthropic (Claude) ─────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ── Tertiary AI Provider: Google Gemini ───────────────────────
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# ── Provider Order (comma-separated, first = primary) ─────────
AI_PROVIDER_ORDER=openai,claude,gemini

# ── Salesforce (for data enrichment callbacks) ────────────────
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

# ── Redis cache (optional — set blank to disable) ─────────────
REDIS_URL=redis://localhost:6379

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
